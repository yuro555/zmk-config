// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

CONFIG_ZMK_POINTING=y

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10


#include <dt-bindings/zmk/pointing.h>


enum layer_number {
	_QWERTY = 0,
	_GAME,
	_RIGHTHAND,
	_SHIFT,
	_CURSOR,
	_SYMBOLS,
	_TENKEY,
	_MOUSE,
	_ADJUST,
}; 




/ {
	// Define a default keymap here.
	// See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
	keymap {
		compatible = "zmk,keymap";
		
		
		qwerty {
			bindings = <
			&kp ESC   &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp SLSH
			&kp TAB   &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp MINS &kp EQL
			&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp BSPC &kp GRV
			&kp LCTRL &kp LGUI &kp LALT &mo _MOUSE &lt _SHIFT LANG2 &kp SPACE &kp ENTER &lt _SYMBOLS INT2 &mo _CURSOR &mo _TENKEY &kp APP &mo _ADJUST &none
			>;
		};
		game {
			bindings = <
			&none &none &none &none &none &none &none &none &none &none &none &kp BSPC
			&none &none &none &none &none &none &none &none &none &none &kp UP &kp ENTER
			&none &none &none &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT
			&none &none &none &none &none &none &none &none &none &none &kp RALT &none &none
			>;
		};
		righthand {
			bindings = <
			&tog _RIGHTHAND &kp P &kp O &kp I &kp U &kp Y &kp T &kp R &kp E &kp W &kp Q &kp ESC
			&none &kp MINS &kp L &kp K &kp J &kp H &kp G &kp F &kp D &kp S &kp A &kp TAB
			&none &kp BSPC &kp DOT &kp COMMA &kp M &kp N &kp B &kp V &kp C &kp X &kp Z &kp RSHIFT
			&none &none &none &none &none &none &msc SCRL_UP &mmv MOVE_SCRL_DOWN &none &none &kp RALT &kp RCTRL &none
			>;
		};
		shift {
			bindings = <
			&none &kp LS(Q) &kp LS(W) &kp LS(E) &kp LS(R) &kp LS(T) &kp LS(Y) &kp LS(U) &kp LS(I) &kp LS(O) &kp LS(P) &kp LS(QUES)
			&none &kp LS(A) &kp LS(S) &kp LS(D) &kp LS(F) &kp LS(G) &kp LS(H) &kp LS(J) &kp LS(K) &kp LS(L) &kp LS(UNDS) &kp LS(DQUO)
			&none &kp LS(Z) &kp LS(X) &kp LS(C) &kp LS(V) &kp LS(B) &kp LS(N) &kp LS(M) &kp LS(LABK) &kp LS(RABK) &kp DEL &kp RSHIFT
			&none &none &none &none &none &none &kp ENTER &none &none &none &kp RALT &kp RCTRL &none
			>;
		};
		cursor {
			bindings = <
			&kp GRV &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp HOME &none &kp UP &kp APP &kp PGUP &kp HOME
			&none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp END &kp LEFT &kp DOWN &kp RIGHT &kp PGDN &kp END
			&none &kp DOT &kp COMMA &kp EQL &kp PLUS &kp MINS &none &kp LANG2 &kp GRV &kp INT2 &kp DEL &kp RSHIFT
			&none &none &none &none &kp ENTER &none &none &none &none &none &kp RALT &kp RCTRL &none
			>;
		};
		symbols {
			bindings = <
			&none &kp QUES &kp HASH &kp ASTR &kp PERC &kp CIRC &kp YEN &kp LABK &kp RABK &kp LCBR &kp RCBR &kp COLN
			&none &kp PLUS &kp MINS &kp S &kp EQL &kp TILD &kp UNDS &kp COLN &kp SCLN &kp LPRN &kp RPRN &kp SCLN
			&none &kp AT &kp DLR &kp AMPR &kp PIPE &kp EXLM &kp GRV &kp QUOT &kp DQUO &kp LBRC &kp RBRC &kp RSHIFT
			&none &none &none &none &none &none &none &none &none &none &kp RALT &kp RCTRL &none
			>;
		};
		tenkey {
			bindings = <
			&none &kp F9 &kp F10 &kp F11 &kp F12 &kp PSLS &kp PMNS &kp PCMM &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp ESC
			&none &kp F5 &kp F6 &kp F7 &kp F8 &kp PAST &kp PPLS &kp PDOT &kp K_N4 &kp K_N5 &kp K_N6 &kp TAB
			&none &kp F1 &kp F2 &kp F3 &kp F4 &kp PENT &kp PEQL &kp K_N0 &kp K_N1 &kp K_N2 &kp K_N3 &kp RSHIFT
			&none &none &none &none &none &none &none &none &kp SPACE &none &kp RALT &kp RCTRL &none
			>;
		};
		mouse {
			bindings = <
			&none &msc SCRL_UP &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MB3 &mkp MB4 &msc SCRL_UP &msc SCRL_LEFT &mmv UP &msc SCRL_RIGHT &kp PGUP &kp HOME
			&none &msc SCRL_DOWN &mmv MOVE_UP &mkp MB2 &mkp MB1 &mkp MB5 &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp PGDN &kp END
			&none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none &none &mkp MB1 &mkp MB2 &kp RALT &kp RGUI &kp ESC
			&none &none &none &none &none &none &none &kp LCTRL &kp LSHIFT &kp TAB &kp ESC &kp ESC &none
			>;
		};
		adjust {
			bindings = <
			&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &kp CAPS &kp SCRL &kp NUM &kp INS &kp PSCR &kp PAUS &none
			&none  &tog _QWERTY &tog _GAME &none &none &none &none &none &none &none &none &none
			&none &bt BT_CLR &none &none &none &none &none &none &none &none &none &none
			&kp MUTE &kp VOLD &kp VOLU &none &none &none &none &none &none &none &tog _RIGHTHAND &none &none
			>;
		};
		
		
		
	};
};


