// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>


#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10


#include <dt-bindings/zmk/pointing.h>


//レイヤー定義
#define _QWERTY = 0
#define _GAME = 1
#define _RIGHTHAND = 2
#define _SHIFT = 3
#define _CURSOR = 4
#define _SYMBOLS = 5
#define _TENKEY = 6
#define _MOUSE = 7
#define _ADJUST = 8

//JP定義

#define JP_ZKHK  GRAVE        // Zenkaku ↔ Hankaku ↔ Kanji (半角 ↔ 全角 ↔ 漢字)
#define JP_MINUS MINUS        // -
#define JP_CARET EQUAL        // ^
#define JP_YEN   INT3         // ¥
#define JP_AT    LBKT         // @
#define JP_LBKT  RBKT         // [
#define JP_EISU  CAPS         // Eisū (英数)
#define JP_SEMI  SEMI         // ;
#define JP_COLON SQT          // :
#define JP_RBKT  NUHS         // ]
#define JP_COMMA COMMA        // ,
#define JP_DOT   DOT          // .
#define JP_SLASH SLASH        // /
#define JP_BSLH  INT1         // (backslash)
#define JP_MHEN  INT5         // Muhenkan (無変換)
#define JP_HENK  INT4         // Henkan (変換)
#define JP_KANA  INT2         // Katakana ↔ Hiragana ↔ Rōmaji (カタカナ ↔ ひらがな ↔ ローマ字)
#define JP_EXCL  LS(N1)       // !
#define JP_DQT   LS(N2)       // "
#define JP_HASH  LS(N3)       // #
#define JP_DLLR  LS(N4)       // $
#define JP_PRCNT LS(N5)       // %
#define JP_AMPS  LS(N6)       // &
#define JP_SQT   LS(N7)       // '
#define JP_LPAR  LS(N8)       // (
#define JP_RPAR  LS(N9)       // )
#define JP_EQUAL LS(JP_MINUS) // =
#define JP_TILDE LS(JP_CARET) // ~
#define JP_PIPE  LS(JP_YEN)   // |
#define JP_GRAVE LS(JP_AT)    // `
#define JP_LBRC  LS(JP_LBKT)  // {
#define JP_CAPS  LS(JP_EISU)  // Caps Lock
#define JP_PLUS  LS(JP_SEMI)  // +
#define JP_ASTRK LS(JP_COLON) // *
#define JP_RBRC  LS(JP_RBKT)  // }
#define JP_LT    LS(JP_COMMA) // <
#define JP_RT    LS(JP_DOT)   // >
#define JP_QMARK LS(JP_SLASH) // ?
#define JP_UNDER LS(JP_BSLH)  // _

OP?
L_:
> ""
		?#*%^\<>{}?
		+-/=~_;:():
		@$&|!`'"[]"

/ {
	// Define a default keymap here.
	// See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
	keymap {
		compatible = "zmk,keymap";
		
		
		qwerty {
			display-name = "qwerty";
			bindings = <
			k&kp ESC &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp SLASH
			&kp TAB &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp JP_MINUS &kp JP_EQUAL
			&kp LSHIFT &kp Z &kp X &kp C &kp V &kp B &kp N &kp M &kp JP_COMMA &kp JP_DOT &kp BSPC &kp GRAVE
			&kp LCTRL &kp LGUI &kp LALT &mo _MOUSE &lt _SHIFT LANG2 &kp SPACE &kp ENTER &lt _SYMBOLS INT2 &mo _CURSOR &mo _TENKEY &kp APP &mo _ADJUST &none
			>;
		};
		game {
			display-name = "game";
			bindings = <
			&none &none &none &none &none &none &none &none &none &none &none &kp BSPC
			&none &none &none &none &none &none &none &none &none &none &kp UP &kp ENTER
			&none &none &none &none &none &none &none &none &none &kp LEFT &kp DOWN &kp RIGHT
			&none &none &none &none &none &none &none &none &none &none &kp RALT &none &none
			>;
		};
		righthand {
			display-name = "righthand";
			bindings = <
			&tog _RIGHTHAND &kp P &kp O &kp I &kp U &kp Y &kp T &kp R &kp E &kp W &kp Q &kp ESC
			&none &kp JP_MINUS &kp L &kp K &kp J &kp H &kp G &kp F &kp D &kp S &kp A &kp TAB
			&none &kp BSPC &kp JP_DOT &kp JP_COMMA &kp M &kp N &kp B &kp V &kp C &kp X &kp Z &kp RSHIFT
			&none &none &none &none &none &none &msc SCRL_UP &mmv MOVE_SCRL_DOWN &none &none &kp RALT &kp RCTRL &none
			>;
		};
		shift {
			display-name = "shift";
			bindings = <
			&none &kp LS(Q) &kp LS(W) &kp LS(E) &kp LS(R) &kp LS(T) &kp LS(Y) &kp LS(U) &kp LS(I) &kp LS(O) &kp LS(P) &kp JP_QMARK
			&none &kp LS(A) &kp LS(S) &kp LS(D) &kp LS(F) &kp LS(G) &kp LS(H) &kp LS(J) &kp LS(K) &kp LS(L) &kp JP_UNDER &kp JP_COLON
			&none &kp LS(Z) &kp LS(X) &kp LS(C) &kp LS(V) &kp LS(B) &kp LS(N) &kp LS(M) &kp JP_LT &kp JP_RT &kp DEL &kp RSHIFT
			&none &none &none &none &none &none &kp ENTER &none &none &none &kp RALT &kp RCTRL &none
			>;
		};
		cursor {
			display-name = "cursor";
			bindings = <
			&kp GRAVE &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp HOME &none &kp UP &kp APP &kp PG_UP &kp HOME
			&none &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp END &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &kp END
			&none &kp JP_DOT &kp JP_COMMA &kp JP_EQUAL &kp JP_PLUS &kp JP_MINUS &none &kp LANG2 &kp GRAVE &kp INT2 &kp DEL &kp RSHIFT
			&none &none &none &none &kp ENTER &none &none &none &none &none &kp RALT &kp RCTRL &none
			>;
		};
		symbols {
			display-name = "symbols";
			bindings = <
			&none &kp JP_QMARK &kp JP_HASH &kp JP_ASTRK &kp JP_PRCNT &kp JP_CARET &kp JP_YEN &kp JP_LT &kp JP_RT &kp JP_LBRC &kp JP_RBRC &kp JP_QMARK
			&none &kp JP_PLUS &kp JP_MINUS &kp S &kp JP_EQUAL &kp JP_TILDE &kp JP_UNDER &kp JP_SEMI &kp JP_COLON &kp JP_LPAR &kp JP_RPAR &kp JP_COLON
			&none &kp JP_AT &kp JP_DLLR &kp JP_AMPS &kp JP_PIPE &kp JP_EXCL &kp JP_GRAVE &kp JP_SQT &kp JP_DQT &kp JP_LBKT &kp JP_RBKT &kp JP_DQT
			&none &none &none &none &none &none &none &none &none &none &kp RALT &kp RCTRL &none
			>;
		};


		tenkey {
			display-name = "tenkey";
			bindings = <
			&none &kp F9 &kp F10 &kp F11 &kp F12 &kp KP_SLASH &kp KP_MINUS &kp KP_COMMA &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp ESC
			&none &kp F5 &kp F6 &kp F7 &kp F8 &kp KP_ASTERISK &kp KP_PLUS &kp KP_DOT &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp TAB
			&none &kp F1 &kp F2 &kp F3 &kp F4 &kp KP_ENTER &kp KP_EQUAL &kp KP_N0 &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp RSHIFT
			&none &none &none &none &none &none &none &none &kp SPACE &none &kp RALT &kp RCTRL &none
			>;
		};
		mouse {
			display-name = "mouse";
			bindings = <
			&none &msc SCRL_UP &msc SCRL_LEFT &msc SCRL_RIGHT &mkp MB3 &mkp MB4 &msc SCRL_UP &msc SCRL_LEFT &mmv UP &msc SCRL_RIGHT &kp PG_UP &kp HOME
			&none &msc SCRL_DOWN &mmv MOVE_UP &mkp MB2 &mkp MB1 &mkp MB5 &msc SCRL_DOWN &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &kp PG_DN &kp END
			&none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_RIGHT &none &none &none &mkp MB1 &mkp MB2 &kp RALT &kp RGUI &kp ESC
			&none &none &none &none &none &none &none &kp LCTRL &kp LSHIFT &kp TAB &kp ESC &kp ESC &none
			>;
		};
		adjust {
			display-name = "adjust";
			bindings = <
			&none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &none &kp CAPS &kp SLCK &kp KP_NUM&kp INS &kp PSCRN &kp PAUSE_BREAK &none
			&kp C_BRI_UP  &tog _QWERTY &tog _GAME &none &none &none &none &none &none &none &none &none
			&kp C_BRI_DN &bt BT_CLR &none &none &none &none &none &none &none &none &none &none
			&kp C_MUTE &kp C_VOL_UP &kp C_VOL_DN &none &none &none &none &none &none &none &tog _RIGHTHAND &none &none
			>;
		};
	};
};


