#include "pixycheck48tact-layouts.dtsi"
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    matrix_transform0: matrix_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <8>;
        rows = <7>;
        map = <
            RC(0,1) RC(2,1) RC(3,1) RC(4,1) RC(5,1) RC(6,1)
            RC(1,0) RC(2,0) RC(3,0) RC(4,0) RC(5,0) RC(6,0)
            RC(1,2) RC(0,2) RC(3,2) RC(4,2) RC(5,2) RC(6,2)
            RC(1,3) RC(0,3) RC(2,3) RC(4,3) RC(5,3) RC(6,3)
            RC(1,4) RC(0,4) RC(2,4) RC(3,4) RC(5,4) RC(6,4)
            RC(1,5) RC(0,5) RC(2,5) RC(3,5) RC(4,5) RC(6,5)
            RC(1,6) RC(0,6) RC(2,6) RC(3,6) RC(4,6) RC(5,6)
            RC(1,7) RC(0,7) RC(2,7) RC(3,7) RC(4,7) RC(5,7) RC(6,7)
        >;
    };
};

&physical_layout_pixycheck48tact {
    transform = <&matrix_transform0>;
};

